{
  "name": "statadvisor",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev -w @statadvisor/api\" \"npm run dev -w @statadvisor/web\"",
    "build": "npm run build -w @statadvisor/web",
    "preview": "npm run preview -w apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e -w apps/web",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:api": "npm run dev -w @statadvisor/api",
    "dev:web": "npm run dev -w @statadvisor/web",
    "start": "npm run build && node apps/api/src/index.ts",
    "backup": "node tools/backup.mjs",
    "reset-data": "node tools/backup.mjs --reset"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
